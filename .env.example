# OMP Shipment Tracker — environment
# Copy to .env (or set these in Railway's Variables tab). EVERYTHING is optional:
# with none of these set, the app boots in local dev mode (JSON files + ?user= auth).

# HTTP port. Railway injects this automatically; locally defaults to 4332.
PORT=4332

# --- Postgres store (optional) ------------------------------------------------
# When set, shipments/updates are read/written through Postgres instead of the
# JSON files. Run `npm run initdb` once to create tables and seed shipments.
# Railway Postgres plugin exposes this as ${{Postgres.DATABASE_URL}}.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Google OAuth login (optional) --------------------------------------------
# When ALL THREE of CLIENT_ID / CLIENT_SECRET / SESSION_SECRET are set, the app
# switches from ?user= dev auth to real Google OAuth. If any is missing, dev
# auth stays on.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# Authorized redirect URI registered in Google Cloud. If omitted, it is derived
# from the request host as <proto>://<host>/auth/google/callback.
# GOOGLE_CALLBACK_URL=https://your-app.up.railway.app/auth/google/callback
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional: map real Google emails to internal POC scope -------------------
# JSON object mapping a Google login email to an internal user email (from
# /api/users). Unmapped, unrecognised logins become a flagged guest with no
# shipments.
# AUTH_USERS={"ashwin.singh@recykal.com":"aishwarya@local.associate"}
